{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "config.realms.schema.json",
  "title": "境界序列（content/config/realms.json）",
  "description": "境界 = 进度主轴（CONTEXT.md 境界词条）。序列条目数与名称全在本集合：引擎只按 index 排序与查表，绝不按具体境界名或数量分支（形状清单 #11）。config 集合每集合一文件（content.md 惯例）。",
  "type": "object",
  "required": ["realms"],
  "properties": {
    "realms": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/realm" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "realm": {
      "type": "object",
      "required": ["id", "index", "name", "cultivationRequired"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^realm-[0-9]{2,}$",
          "description": "config 集合豁免序号段（content.md id 规则），用语义名 + 序号"
        },
        "index": {
          "type": "integer",
          "minimum": 1,
          "description": "境界序号（1 起，连续）。当前 6 个仅是内容现状，不是引擎常量。"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "境界名（不入流/三流/二流/一流/绝顶/宗师，见 CONTEXT.md）"
        },
        "cultivationRequired": {
          "type": "integer",
          "minimum": 0,
          "description": "攒满多少修为可突破（修为主要来自闭关，不来自战斗）"
        },
        "breakthroughCost": {
          "type": "array",
          "description": "突破消耗（突破丹/材料）。MVP 突破 100% 成功，失败惩罚（走火入魔）留 v2。",
          "items": {
            "type": "object",
            "required": ["itemId", "amount"],
            "properties": {
              "itemId": { "type": "string" },
              "amount": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "next": {
          "type": ["string", "null"],
          "description": "下一境界 id；末境界为 null。校验器据此检查连通性闭环（BRIEF §8.6）。"
        },
        "modifiers": {
          "$ref": "#/definitions/modifierList",
          "description": "裸装基础数值（生命/内力上限等）。必须走修饰符聚合管线（ADR-0005），禁止直改属性。"
        },
        "gating": {
          "type": "object",
          "description": "门槛（广度）：本境界允许进入的秘境与入池的底材。⚠️ 与秘境层数（深度）是两回事，不可混（BRIEF §9.7）。",
          "properties": {
            "dungeons": { "type": "array", "items": { "type": "string" } },
            "equipmentBases": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "description": {
          "type": "string",
          "description": "叙事文本，须遵守 content/style-guide.md"
        }
      },
      "additionalProperties": false
    },
    "modifierList": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}
