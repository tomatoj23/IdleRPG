{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["offlineCapSeconds", "startingRealmId"],
  "properties": {
    "offlineCapSeconds": { "type": "number", "exclusiveMinimum": 0 },
    "startingRealmId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "displayTiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["min", "name"],
        "properties": {
          "min": { "type": "number", "minimum": 0 },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
