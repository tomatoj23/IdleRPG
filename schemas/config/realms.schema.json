{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["realms"],
  "properties": {
    "realms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "progress"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "progress": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resourceId", "cap"],
            "properties": {
              "resourceId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "cap": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    }
  }
}
