{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "event.schema.json",
  "title": "奇遇事件（content/event/，每条目一文件）",
  "description": "⚠️ 形态未定：CONTEXT.md 无「奇遇」词条，docs/design-spec-BRIEF.md 亦无奇遇章节（BRIEF §12.5 列为未讨论方向）。本 schema 只留**最小骨架**，保证集合存在且可被校验；形态确定后再扩充字段。叙事长度 3~6 句（style-guide.md）。",
  "type": "object",
  "required": ["id", "text"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt-[a-z0-9-]+$",
      "description": "如 evt-crossroad-001"
    },
    "title": { "type": "string", "minLength": 1 },
    "text": {
      "type": "string",
      "minLength": 1,
      "description": "叙事正文（3~6 句），须遵守 content/style-guide.md"
    },
    "conditions": {
      "type": "object",
      "description": "触发条件（所在区域 / 境界序号 / 已学武功等）。取值键可扩展，引擎只做键取值与求交。",
      "additionalProperties": {}
    },
    "options": {
      "type": "array",
      "description": "双选项小按钮（ui 参考）；每选项可挂效果引用",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "effects": { "type": "array", "items": { "type": "string" }, "description": "指向 content/effects/" }
        },
        "additionalProperties": false
      }
    },
    "regionId": { "type": "string" },
    "weight": { "type": "number", "minimum": 0, "description": "抽取权重（若为随机触发）" },
    "tags": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    }
  },
  "additionalProperties": false
}
